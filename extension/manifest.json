{
  "manifest_version": 3,
  "name": "Go Search",
  "description": "Your keywords. Straight to the right search.",
  "version": "0.5.1",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.bing.com/*",
    "https://duckduckgo.com/*",
    "https://en.wikipedia.org/*",
    "https://www.youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.bundle.js"
    ],
    "persistent": false
  },
  "action": {
    "default_title": "Go Search",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png",
      "64": "icons/toolbar-64.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "icons": {
    "48": "icons/toolbar-48.png",
    "128": "icons/toolbar-128.png",
    "256": "icons/toolbar-256.png",
    "512": "icons/toolbar-512.png",
    "1024": "icons/toolbar-1024.png"
  }
}
